# Copy to .env and fill in: cp .env.example .env
# Generate values with: openssl rand -hex 16
S3_ACCESS_KEY=admin
S3_SECRET_KEY=change-me
POSTGRES_USER=bikes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bikes

# Only needed to run the eval (evals/run_eval.py). Leave unset otherwise.
# ANTHROPIC_API_KEY=change-me

